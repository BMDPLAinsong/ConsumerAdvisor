@* 路由定义：设置页面的URL为 /settings *@
@page "/settings"
@* 注入用户设置服务，用于读写用户配置 *@
@inject UserSettingsService SettingsService
@* 注入日志服务，用于记录操作日志 *@
@inject ILogger<Settings> Logger

@* 设置页面根容器，使用紫色渐变背景 *@
<div class="settings-page">
    @* 内容居中容器，限制最大宽度 *@
    <div class="container">
        @* 页面头部区域，包含返回按钮和标题 *@
        <div class="page-header">
            @* 返回主页的导航链接 *@
            <a href="/" class="back-btn">🏠 返回主页</a>
            @* 页面主标题 *@
            <h1>⚙️ 设置</h1>
        </div>

        @* 判断设置对象是否为空，空则显示加载提示 *@
        @if (settings == null)
        {
            @* 加载中提示信息 *@
            <div class="loading">加载中...</div>
        }
        else
        {
            @* 收入与支出设置卡片 *@
            <div class="card">
                @* 卡片标题 *@
                <h3>💰 收入与支出</h3>
                @* 月收入输入表单组 *@
                <div class="form-group">
                    @* 月收入标签 *@
                    <label>月收入 (元)</label>
                    @* 月收入数值输入框，双向绑定到 settings.MonthlyIncome *@
                    <input type="number" @bind="settings.MonthlyIncome" class="input-field" step="100" />
                </div>
                @* 月固定支出输入表单组 *@
                <div class="form-group">
                    @* 月固定支出标签 *@
                    <label>月固定支出 (元)</label>
                    @* 月固定支出数值输入框，双向绑定到 settings.MonthlyExpenses *@
                    <input type="number" @bind="settings.MonthlyExpenses" class="input-field" step="100" />
                </div>
                @* 月储蓄目标输入表单组 *@
                <div class="form-group">
                    @* 月储蓄目标标签 *@
                    <label>月储蓄目标 (元)</label>
                    @* 月储蓄目标数值输入框，双向绑定到 settings.SavingsTarget *@
                    <input type="number" @bind="settings.SavingsTarget" class="input-field" step="100" />
                </div>
                @* 可支配收入计算结果展示区 *@
                <div class="calculated-info">
                    @* 可支配收入标签文本 *@
                    <span>可支配收入：</span>
                    @* 可支配收入计算：月收入-月支出-储蓄目标，格式化为整数 *@
                    <strong>@((settings.MonthlyIncome - settings.MonthlyExpenses - settings.SavingsTarget).ToString("F0")) 元</strong>
                </div>
            </div>

            @* 冷静期设置卡片 *@
            <div class="card">
                @* 卡片标题 *@
                <h3>⏱️ 冷静期设置</h3>
                @* 冷静期时长表单组 *@
                <div class="form-group">
                    @* 冷静期标签 *@
                    <label>冷静期时长 (小时)</label>
                    @* 滑块容器，横向排列 *@
                    <div class="range-container">
                        @* 冷静期时长滑块，范围12-168小时，步长12小时 *@
                        <input type="range" @bind="settings.WaitingPeriodHours" min="12" max="168" step="12" class="range-slider" />
                        @* 当前选择的冷静期时长显示 *@
                        <span class="range-value">@settings.WaitingPeriodHours 小时</span>
                    </div>
                    @* 滑块刻度标签，显示各时间节点 *@
                    <div class="range-labels">
                        @* 12小时标签 *@
                        <span>12小时</span>
                        @* 1天标签 *@
                        <span>1天</span>
                        @* 3天标签 *@
                        <span>3天</span>
                        @* 7天标签 *@
                        <span>7天</span>
                    </div>
                </div>
            </div>

            @* 需求匹配度灵敏度设置卡片 *@
            <div class="card">
                @* 卡片标题 *@
                <h3>🎯 需求匹配度灵敏度</h3>
                @* 需求匹配度阈值表单组 *@
                <div class="form-group">
                    @* 阈值标签 *@
                    <label>需求匹配度阈值 (%)</label>
                    @* 滑块容器 *@
                    <div class="range-container">
                        @* 阈值滑块，范围0-100%，步长5% *@
                        <input type="range" @bind="settings.DemandMatchThreshold" min="0" max="100" step="5" class="range-slider" />
                        @* 当前阈值百分比显示 *@
                        <span class="range-value">@settings.DemandMatchThreshold%</span>
                    </div>
                    @* 滑块刻度标签 *@
                    <div class="range-labels">
                        @* 宽松标签 *@
                        <span>宽松</span>
                        @* 适中标签 *@
                        <span>适中</span>
                        @* 严格标签 *@
                        <span>严格</span>
                        @* 极严标签 *@
                        <span>极严</span>
                    </div>
                    @* 阈值说明区域，解释低于阈值时的行为 *@
                    <div class="threshold-desc">
                        @* 阈值说明段落 *@
                        <p>当需求匹配度低于 <strong>@settings.DemandMatchThreshold%</strong> 时：</p>
                        @* 行为列表 *@
                        <ul>
                            @* 提醒不建议购买 *@
                            <li>⚠️ 提醒不建议购买</li>
                            @* 自动建议冷静期 *@
                            <li>⏱️ 自动建议冷静 <strong>@settings.WaitingPeriodHours</strong> 小时</li>
                        </ul>
                    </div>
                </div>
            </div>

            @* 提醒设置卡片 *@
            <div class="card">
                @* 卡片标题 *@
                <h3>🔔 提醒设置</h3>
                @* 站内提醒开关组 *@
                <div class="toggle-group">
                    @* 启用站内提醒复选框 *@
                    <label class="toggle-item">
                        @* 启用提醒复选框，双向绑定 *@
                        <input type="checkbox" @bind="settings.EnableNotifications" />
                        @* 启用提醒标签 *@
                        <span>启用站内提醒</span>
                    </label>
                </div>

                @* 仅在启用提醒时显示详细提醒选项 *@
                @if (settings.EnableNotifications)
                {
                    @* 详细提醒选项容器 *@
                    <div class="notification-options">
                        @* 显示倒计时选项 *@
                        <label class="toggle-item">
                            @* 倒计时复选框 *@
                            <input type="checkbox" @bind="settings.NotificationPreferences.ShowCountdown" />
                            @* 显示倒计时标签 *@
                            <span>显示倒计时</span>
                        </label>
                        @* 显示待冷静徽章选项 *@
                        <label class="toggle-item">
                            @* 徽章复选框 *@
                            <input type="checkbox" @bind="settings.NotificationPreferences.ShowBadge" />
                            @* 显示徽章标签 *@
                            <span>显示待冷静徽章</span>
                        </label>
                        @* 12小时后提醒选项 *@
                        <label class="toggle-item">
                            @* 12小时提醒复选框 *@
                            <input type="checkbox" @bind="settings.NotificationPreferences.EnableReminderAt12Hours" />
                            @* 12小时后提醒标签 *@
                            <span>12小时后提醒</span>
                        </label>
                        @* 1小时后提醒选项 *@
                        <label class="toggle-item">
                            @* 1小时提醒复选框 *@
                            <input type="checkbox" @bind="settings.NotificationPreferences.EnableReminderAt1Hour" />
                            @* 1小时后提醒标签 *@
                            <span>1小时后提醒</span>
                        </label>
                        @* 冷静期结束时提醒选项 *@
                        <label class="toggle-item">
                            @* 过期提醒复选框 *@
                            <input type="checkbox" @bind="settings.NotificationPreferences.EnableReminderAtExpired" />
                            @* 冷静期结束时提醒标签 *@
                            <span>冷静期结束时提醒</span>
                        </label>
                    </div>
                }
            </div>

            @* Toast提示消息，保存成功或失败时显示 *@
            @if (!string.IsNullOrEmpty(toastMessage))
            {
                @* Toast提示容器，根据toastType显示不同样式 *@
                <div class="toast toast-@toastType">
                    @* Toast消息文本 *@
                    <span>@toastMessage</span>
                </div>
            }

            @* 操作按钮区域 *@
            <div class="actions">
                @* 保存按钮，点击触发SaveSettings方法，保存中禁用 *@
                <button @onclick="SaveSettings" disabled="@isSaving" class="btn-save">
                    @* 按钮文本：保存中或保存设置 *@
                    @(isSaving ? "保存中..." : "💾 保存设置")
                </button>
            </div>
        }
    </div>
</div>

@* CSS样式定义区 *@
<style>
    .settings-page {
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #5a3f99 100%);
        padding: 40px 20px;
        position: relative;
    }
    .settings-page::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image: 
            radial-gradient(circle at 20% 80%, rgba(255, 255, 255, 0.08) 0%, transparent 50%),
            radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.08) 0%, transparent 50%);
        pointer-events: none;
        z-index: 0;
    }
    .container {
        max-width: 600px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
    }
    .page-header {
        margin-bottom: 32px;
    }
    .back-btn {
        display: inline-block;
        color: rgba(255, 255, 255, 0.9);
        text-decoration: none;
        font-size: 14px;
        margin-bottom: 16px;
        transition: color 0.2s ease;
    }
    .back-btn:hover {
        color: white;
    }
    .page-header h1 {
        color: white;
        font-size: 32px;
        margin: 0;
    }
    .loading {
        text-align: center;
        color: white;
        padding: 40px;
    }
    .card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.04), 0 10px 20px rgba(0, 0, 0, 0.08);
        padding: 28px;
        margin-bottom: 20px;
    }
    .card h3 {
        color: #2d3748;
        font-size: 18px;
        margin-bottom: 24px;
        padding-bottom: 12px;
        border-bottom: 1px solid #e2e8f0;
    }
    .form-group {
        margin-bottom: 20px;
    }
    .form-group label {
        display: block;
        color: #4a5568;
        font-size: 14px;
        font-weight: 500;
        margin-bottom: 8px;
    }
    .input-field {
        width: 100%;
        padding: 14px 16px;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        font-size: 16px;
        transition: all 0.2s ease;
    }
    .input-field:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }
    .calculated-info {
        background: linear-gradient(135deg, #f7fafc 0%, #edf2f7 100%);
        padding: 16px;
        border-radius: 12px;
        margin-top: 16px;
    }
    .calculated-info span {
        color: #718096;
        font-size: 14px;
    }
    .calculated-info strong {
        color: #667eea;
        font-size: 20px;
        margin-left: 8px;
    }
    .range-container {
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .range-slider {
        flex: 1;
        height: 6px;
        -webkit-appearance: none;
        appearance: none;
        background: #e2e8f0;
        border-radius: 3px;
        outline: none;
    }
    .range-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 20px;
        height: 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 50%;
        cursor: pointer;
    }
    .range-value {
        min-width: 80px;
        text-align: right;
        font-weight: 600;
        color: #667eea;
    }
    .range-labels {
        display: flex;
        justify-content: space-between;
        margin-top: 8px;
        font-size: 12px;
        color: #a0aec0;
    }
    .threshold-desc {
        background: #f7fafc;
        border-radius: 12px;
        padding: 16px;
        margin-top: 16px;
    }
    .threshold-desc p {
        margin: 0 0 12px 0;
        color: #4a5568;
        font-size: 14px;
    }
    .threshold-desc ul {
        margin: 0;
        padding-left: 20px;
    }
    .threshold-desc li {
        color: #718096;
        font-size: 14px;
        margin-bottom: 6px;
    }
    .threshold-desc li:last-child {
        margin-bottom: 0;
    }
    .threshold-desc strong {
        color: #667eea;
    }
    .toggle-group {
        margin-bottom: 16px;
    }
    .toggle-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        cursor: pointer;
    }
    .toggle-item input[type="checkbox"] {
        width: 20px;
        height: 20px;
        accent-color: #667eea;
    }
    .toggle-item span {
        color: #2d3748;
        font-size: 15px;
    }
    .notification-options {
        background: #f7fafc;
        border-radius: 12px;
        padding: 8px 16px;
    }
    .actions {
        margin-top: 24px;
    }
    .btn-save {
        width: 100%;
        padding: 16px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .btn-save:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(102, 126, 234, 0.3);
    }
    .btn-save:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }
    .toast {
        padding: 14px 16px;
        border-radius: 12px;
        margin-bottom: 16px;
        font-size: 15px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 10px;
        animation: slideDown 0.3s ease;
    }
    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .toast-success {
        background: linear-gradient(135deg, #c6f6d5 0%, #9ae6b4 100%);
        color: #276749;
    }
    .toast-error {
        background: linear-gradient(135deg, #fed7d7 0%, #feb2b2 100%);
        color: #c53030;
    }
    .toast::before {
        font-size: 18px;
    }
    .toast-success::before {
        content: '✅';
    }
    .toast-error::before {
        content: '❌';
    }
</style>

@* C# 代码逻辑区 *@
@code {
    // 用户设置实体，存储所有配置项
    private UserSettings? settings;
    // 保存中状态标志，用于按钮禁用
    private bool isSaving = false;
    // Toast提示消息文本
    private string toastMessage = "";
    // Toast提示类型（success/error）
    private string toastType = "";
    // Toast定时器，3秒后自动隐藏提示
    private Timer? toastTimer;

    // 组件初始化时异步加载用户设置
    protected override async Task OnInitializedAsync()
    {
        // 通过设置服务异步获取配置
        settings = await SettingsService.GetSettingsAsync();
    }

    // 显示Toast提示消息，3秒后自动消失
    private void ShowToast(string message, string type)
    {
        // 设置提示消息文本
        toastMessage = message;
        // 设置提示类型
        toastType = type;
        // 释放旧的定时器
        toastTimer?.Dispose();
        // 创建新的定时器，3秒后清空提示
        toastTimer = new Timer(_ =>
        {
            // 切换到Blazor同步上下文更新UI
            InvokeAsync(() =>
            {
                // 清空提示消息
                toastMessage = "";
                // 清空提示类型
                toastType = "";
            });
        }, null, 3000, Timeout.Infinite);
    }

    // 保存设置到数据库
    private async Task SaveSettings()
    {
        // 防止空引用，设置为空时直接返回
        if (settings == null) return;

        // 设置保存中状态为true，禁用按钮
        isSaving = true;
        try
        {
            // 通过设置服务异步保存配置
            await SettingsService.SaveSettingsAsync(settings);
            // 记录保存成功日志
            Logger.LogInformation("设置已保存");
            // 显示成功提示
            ShowToast("设置保存成功", "success");
        }
        catch (Exception ex)
        {
            // 记录保存失败日志及异常信息
            Logger.LogError(ex, "保存设置失败");
            // 显示失败提示
            ShowToast("保存失败，请重试", "error");
        }
        finally
        {
            // 无论成功失败，都重置保存中状态
            isSaving = false;
        }
    }
}
