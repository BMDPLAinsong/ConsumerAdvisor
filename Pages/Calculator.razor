@* C# 代码逻辑部分 *@
@code {
    // 当前激活的标签页索引，0为单次使用成本，1为支付方案
    private int activeTab = 0;
    // 单次使用成本计算器的输入参数对象
    private CostCalculatorInput costInput = new();
    // 单次使用成本计算结果，可为空表示尚未计算
    private CostCalculationResult? costResult;
    // 支付方案模拟器的输入参数对象
    private PaymentPlanInput paymentInput = new();
    // 支付方案模拟结果，可为空表示尚未计算
    private PaymentPlanResult? paymentResult;
    // 计算进行中标志，用于禁用按钮防止重复提交
    private bool isCalculating = false;

    // 单次使用成本计算方法：异步调用CalculatorService获取计算结果
    private async Task CalculateCost()
    {
        // 验证商品价格必须大于0，否则直接返回
        if (costInput.ProductPrice <= 0) return;
        
        // 设置计算中状态为true
        isCalculating = true;
        try
        {
            // 调用服务层异步计算使用成本
            costResult = await CalculatorService.CalculateUsageCostAsync(costInput);
        }
        catch (Exception ex)
        {
            // 捕获异常并记录错误日志
            Logger.LogError(ex, "计算使用成本失败");
        }
        finally
        {
            // 无论成功或失败都重置计算中状态
            isCalculating = false;
        }
    }

    // 支付方案模拟计算方法：异步调用CalculatorService获取分期方案结果
    private async Task CalculatePayment()
    {
        // 验证商品总价必须大于0，否则直接返回
        if (paymentInput.TotalAmount <= 0) return;

        // 设置计算中状态为true
        isCalculating = true;
        try
        {
            // 调用服务层异步计算支付方案
            paymentResult = await CalculatorService.CalculatePaymentPlanAsync(paymentInput);
        }
        catch (Exception ex)
        {
            // 捕获异常并记录错误日志
            Logger.LogError(ex, "计算支付方案失败");
        }
        finally
        {
            // 无论成功或失败都重置计算中状态
            isCalculating = false;
        }
    }
}
