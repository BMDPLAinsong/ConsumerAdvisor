@* C# 代码逻辑区域 *@
@code {
    // 待处理（冷静期中）的商品列表
    private List<WaitingListItem> pendingItems = new();
    // 已过期（冷静期结束）的商品列表
    private List<WaitingListItem> expiredItems = new();
    // 新商品名称输入值
    private string newProduct = "";
    // 新商品价格输入值（字符串类型，用于解析）
    private string newPrice = "";
    // 新商品购买原因输入值
    private string newReason = "";
    // 添加操作是否正在进行中，用于禁用按钮防止重复提交
    private bool isAdding = false;
    // 定时刷新计时器，用于每分钟更新倒计时
    private Timer? refreshTimer;
    // 当前用户设置对象
    private UserSettings? userSettings;

    // 组件初始化异步方法，加载用户设置和数据，订阅事件，启动定时器
    protected override async Task OnInitializedAsync()
    {
        // 从设置服务异步获取用户设置
        userSettings = await SettingsService.GetSettingsAsync();
        // 异步加载所有清单数据
        await LoadDataAsync();
        
        // 订阅数据变更事件（AI分析完成时触发）
        ListService.DataChanged += OnDataChanged;
        
        // 创建定时器，每分钟触发一次，检查过期商品并刷新数据
        refreshTimer = new Timer(async _ =>
        {
            // 切换到 Blazor 同步上下文执行UI更新操作
            await InvokeAsync(async () =>
            {
                // 检查并更新已过期的商品状态
                await ListService.CheckAndUpdateExpiredAsync();
                // 重新加载数据以更新UI
                await LoadDataAsync();
            });
        }, null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
    }

    // 数据变更事件处理方法，当AI分析完成时自动刷新数据
    private void OnDataChanged()
    {
        // 切换到同步上下文并异步加载数据
        InvokeAsync(async () =>
        {
            // 异步重新加载清单数据
            await LoadDataAsync();
        });
    }

    // 异步加载数据方法，从服务获取所有商品并分类
    private async Task LoadDataAsync()
    {
        // 从服务获取所有等待清单商品
        var allItems = await ListService.GetAllAsync();
        // 筛选出状态为 Pending 的商品作为待冷静列表
        pendingItems = allItems.Where(x => x.Status == WaitingListStatus.Pending).ToList();
        // 筛选出状态为 Expired 的商品作为已过期列表
        expiredItems = allItems.Where(x => x.Status == WaitingListStatus.Expired).ToList();
        // 通知 Blazor 组件状态已变更，触发重新渲染
        StateHasChanged();
    }

    // 添加商品到冷静清单的异步方法
    private async Task AddToWaitingList()
    {
        // 验证商品名称和购买原因是否为空
        if (string.IsNullOrWhiteSpace(newProduct) || string.IsNullOrWhiteSpace(newReason))
            // 验证不通过则直接返回
            return;

        // 设置添加状态为进行中
        isAdding = true;
        try
        {
            // 初始化可空价格变量
            decimal? price = null;
            // 尝试解析价格字符串为数字，若有效且大于0则赋值
            if (decimal.TryParse(newPrice, out var p) && p > 0)
                // 赋值解析后的价格
                price = p;

            // 调用服务添加新商品到等待清单
            await ListService.AddAsync(newProduct, newReason, price);
            
            // 清空商品名称输入框
            newProduct = "";
            // 清空价格输入框
            newPrice = "";
            // 清空原因输入框
            newReason = "";
            
            // 重新加载数据以更新UI
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            // 记录添加操作的错误日志
            Logger.LogError(ex, "添加冷静清单失败");
        }
        finally
        {
            // 无论成功失败都重置添加状态
            isAdding = false;
        }
    }

    // 从清单中移除指定商品的异步方法
    private async Task RemoveItem(Guid id)
    {
        // 调用服务移除指定ID的商品
        await ListService.RemoveAsync(id);
        // 重新加载数据以更新UI
        await LoadDataAsync();
    }

    // 需求匹配阈值属性，从用户设置获取，默认值为70
    private int Threshold => userSettings?.DemandMatchThreshold ?? 70;

    // 判断商品匹配度是否低于用户设置的阈值
    private bool IsBelowThreshold(WaitingListItem item)
    {
        // 优先使用详细分析的需求匹配分数，其次使用快速分析的合理性分数，默认0
        var score = item.BudgetAnalysis?.NeedMatchScore ?? item.QuickAnalysis?.RationalityScore ?? 0;
        // 返回分数是否低于阈值
        return score < Threshold;
    }

    // 获取商品匹配度显示文本（带百分号）
    private string GetMatchScoreDisplay(WaitingListItem item)
    {
        // 获取匹配分数
        var score = item.BudgetAnalysis?.NeedMatchScore ?? item.QuickAnalysis?.RationalityScore ?? 0;
        // 返回带百分号的格式化字符串
        return $"{score}%";
    }

    // 完成购买操作的异步方法
    private async Task CompletePurchase(Guid id)
    {
        // 调用服务将商品标记为已购买
        await ListService.CompletePurchaseAsync(id);
        // 重新加载数据以更新UI
        await LoadDataAsync();
    }

    // 获取剩余时间的友好文本显示
    private string GetRemainingTime(DateTime expiresAt)
    {
        // 计算距离过期的剩余时间
        var remaining = expiresAt - DateTime.UtcNow;
        // 若剩余时间已过期，返回过期提示
        if (remaining.TotalSeconds <= 0)
            // 返回已过期文本
            return "已过期";

        // 若剩余时间大于等于24小时，显示为小时
        if (remaining.TotalHours >= 24)
            // 返回整天数+小时数格式
            return $"{(int)remaining.TotalHours}小时";

        // 若剩余时间大于等于1小时，显示为小时+分钟
        if (remaining.TotalHours >= 1)
            // 返回小时+分钟格式
            return $"{(int)remaining.TotalHours}小时{remaining.Minutes}分";

        // 剩余时间不足1小时，显示为分钟
        return $"{remaining.Minutes}分钟";
    }

    // 获取倒计时徽章的内联样式，根据剩余时间返回不同颜色
    private string GetCountdownStyle(DateTime expiresAt)
    {
        // 计算剩余时间
        var remaining = expiresAt - DateTime.UtcNow;
        // 剩余不足1小时，返回红色警告样式
        if (remaining.TotalHours < 1)
            // 返回红色背景样式
            return "background: #fed7d7; color: #c53030;";
        // 剩余不足6小时，返回橙色警告样式
        if (remaining.TotalHours < 6)
            // 返回橙色背景样式
            return "background: #feebc8; color: #c05621;";
        // 剩余时间充足，返回绿色安全样式
        return "background: #c6f6d5; color: #276749;";
    }

    // 实现 IDisposable 接口，释放资源
    public void Dispose()
    {
        // 释放定时器资源
        refreshTimer?.Dispose();
        // 取消订阅数据变更事件
        ListService.DataChanged -= OnDataChanged;
    }
}
