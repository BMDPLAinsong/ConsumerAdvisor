@* C# 代码逻辑部分 - 页面交互逻辑和数据处理 *@
@code {
    // 输入文本变量 - 存储用户输入的购买想法
    private string inputText = "";
    // 加载状态标志 - 分析过程中为true
    private bool isLoading = false;
    // 错误状态标志 - 发生错误时为true
    private bool hasError = false;
    // 错误消息文本 - 存储错误提示信息
    private string errorMessage = "";
    // 分析结果对象 - 存储AI分析返回的结果，可为空
    private AnalysisResultDto? analysisResult = null;
    // 冷静清单待处理数量 - 显示在导航角标
    private int pendingCount = 0;
    // 用户设置对象 - 存储用户自定义配置
    private UserSettings? userSettings;

    // 页面初始化异步方法 - 组件加载时执行
    protected override async Task OnInitializedAsync()
    {
        // 刷新待处理商品数量
        await RefreshPendingCountAsync();
        // 获取用户设置配置
        userSettings = await SettingsService.GetSettingsAsync();
    }

    // 刷新待处理数量的异步方法
    private async Task RefreshPendingCountAsync()
    {
        // 调用冷静清单服务获取待处理商品数量
        pendingCount = await ListService.GetPendingCountAsync();
    }

    // 需求匹配阈值属性 - 从用户设置获取，默认70%
    private int Threshold => userSettings?.DemandMatchThreshold ?? 70;
    // 建议等待时长属性 - 从用户设置获取，默认24小时
    private int WaitingHours => userSettings?.WaitingPeriodHours ?? 24;

    // 评分样式类属性 - 根据理性度分数返回对应CSS类名
    private string scoreClass => analysisResult?.RationalityScore switch
    {
        // 分数>=70返回高评分样式
        >= 70 => "score-high",
        // 分数>=40返回中评分样式
        >= 40 => "score-medium",
        // 其他情况返回低评分样式
        _ => "score-low"
    };

    // 分析按钮点击处理方法 - 执行购买建议分析
    private async Task Analyze()
    {
        // 验证输入是否为空
        if (string.IsNullOrWhiteSpace(inputText))
        {
            // 显示输入错误提示
            ShowError("请输入购买想法");
            return;
        }

        // 解析用户输入的购买想法
        var parsed = ParserService.Parse(inputText);
        // 检查解析是否成功
        if (!parsed.Success)
        {
            // 显示解析错误信息
            ShowError(parsed.ErrorMessage);
            return;
        }

        // 设置加载状态
        isLoading = true;
        // 清除之前的错误状态
        hasError = false;
        // 清除之前的错误消息
        errorMessage = "";
        // 清除之前的分析结果
        analysisResult = null;

        try
        {
            // 调用需求分析服务进行AI分析
            analysisResult = await Service.AnalyzeAsync(parsed.Product, parsed.Reason);
        }
        catch (Exception ex)
        {
            // 记录分析失败日志
            Logger.LogError(ex, "分析失败");
            // 显示分析失败错误信息
            ShowError($"分析失败: {ex.Message}");
        }
        finally
        {
            // 无论成功失败都结束加载状态
            isLoading = false;
        }
    }

    // 加入冷静清单方法 - 将低理性度商品加入等待列表
    private async Task AddToWaitingList()
    {
        // 如果分析结果为空则直接返回
        if (analysisResult == null) return;

        try
        {
            // 调用冷静清单服务添加商品
            await ListService.AddAsync(analysisResult.Product, analysisResult.Reason);
            // 刷新待处理数量
            await RefreshPendingCountAsync();
            // 记录添加成功日志
            Logger.LogInformation("商品 '{Product}' 已加入冷静清单", analysisResult.Product);

            // 清空输入框
            inputText = "";
            // 清空分析结果显示
            analysisResult = null;
        }
        catch (Exception ex)
        {
            // 记录添加失败日志
            Logger.LogError(ex, "加入冷静清单失败");
            // 显示添加失败错误信息
            ShowError($"加入冷静清单失败: {ex.Message}");
        }
    }

    // 显示错误信息的辅助方法
    private void ShowError(string message)
    {
        // 设置错误状态为true
        hasError = true;
        // 存储错误消息文本
        errorMessage = message;
        // 清空分析结果
        analysisResult = null;
    }
}