@* 页面路由配置 - 设置为首页 *@
@page "/"
@* 注入需求分析服务，用于消费心理分析 *@
@inject RequirementAnalysisService Service
@* 注入冷静清单服务，用于管理待冷静处理的商品列表 *@
@inject WaitingListService ListService
@* 注入输入解析服务，用于解析用户输入的购买想法 *@
@inject InputParserService ParserService
@* 注入用户设置服务，用于获取用户偏好配置 *@
@inject UserSettingsService SettingsService
@* 注入日志记录器，用于记录运行日志 *@
@inject ILogger<Index> Logger

@* 页面根容器 - 包裹整个页面内容 *@
<div class="page-wrapper">
    @* 主内容容器 - 限制最大宽度居中显示 *@
    <div class="container">
        @* 页面头部导航区域 *@
        <div class="page-header">
            @* 导航链接容器 *@
            <div class="nav-links">
                @* 首页导航按钮 - 当前页面高亮显示 *@
                <a href="/" class="nav-link active">🏠 首页</a>
                @* 冷静清单导航按钮 - 带待处理数量角标 *@
                <a href="/waiting-list" class="nav-link">
                    @* 冷静清单图标 *@
                    🧊 冷静清单
                    @* 当有待处理项目时显示数量角标 *@
                    @if (pendingCount > 0)
                    {
                        @* 显示待处理商品数量的红色徽章 *@
                        <span class="badge">@pendingCount</span>
                    }
                </a>
                @* 计算器导航按钮 *@
                <a href="/calculator" class="nav-link">💰 计算器</a>
            </div>
        </div>

        @* 主卡片区域 - 包含输入表单和分析按钮 *@
        <div class="card">
            @* 页面标题 *@
            <h1>消费建议分析器</h1>
            @* 副标题说明 - AI驱动的消费心理学分析简介 *@
            <p class="subtitle">AI 驱动的消费心理学分析，帮您做出更理性的购买决策</p>

            @* 输入框区域 *@
            <div class="input-group">
                @* 输入框标签 *@
                <label for="inputText">请输入您的购买想法</label>
                @* 多行文本输入框 - 用于输入购买想法 *@
                <textarea id="inputText" @bind="inputText" placeholder="例如：我想买戴森吹风机，因为女朋友生日快到了" rows="4" class="@(hasError ? "error" : "")"></textarea>
                @* 输入格式说明提示 *@
                <div class="example">格式：我想买{商品}，因为{原因}</div>
            </div>

            @* 按钮区域 *@
            <div class="button-group">
                @* 分析按钮 - 触发购买建议分析 *@
                <button class="btn @(isLoading ? "loading" : "")" @onclick="Analyze" disabled="@isLoading">@(isLoading ? "分析中..." : "🔍 分析购买建议")</button>
            </div>

            @* 错误提示区域 - 仅在发生错误时显示 *@
            @if (hasError)
            {
                @* 显示错误消息 *@
                <div class="error-message">@errorMessage</div>
            }
        </div>

        @* 分析结果卡片 - 仅在有分析结果时显示 *@
        @if (analysisResult != null)
        {
            @* 结果卡片容器 *@
            <div class="result-card">
                @* 结果头部 - 包含标题和评分徽章 *@
                <div class="result-header">
                    @* 结果标题 *@
                    <div class="result-title">分析结果</div>
                    @* 理性度评分徽章 - 根据分数显示不同颜色 *@
                    <div class="score-badge @scoreClass">@analysisResult.RationalityScore</div>
                </div>

                @* 结果网格布局 - 展示各项分析指标 *@
                <div class="result-grid">
                    @* 商品名称展示 *@
                    <div class="result-item">
                        @* 指标标签 *@
                        <div class="result-label">商品</div>
                        @* 指标值 - 商品名称 *@
                        <div class="result-value">@analysisResult.Product</div>
                    </div>
                    @* 购买原因展示 *@
                    <div class="result-item">
                        @* 指标标签 *@
                        <div class="result-label">购买原因</div>
                        @* 指标值 - 购买原因 *@
                        <div class="result-value">@analysisResult.Reason</div>
                    </div>
                    @* 需求类型展示 *@
                    <div class="result-item">
                        @* 指标标签 *@
                        <div class="result-label">需求类型</div>
                        @* 指标值 - 需求类型 *@
                        <div class="result-value">@analysisResult.DemandType</div>
                    </div>
                    @* 建议等待时间展示 *@
                    <div class="result-item">
                        @* 指标标签 *@
                        <div class="result-label">建议等待</div>
                        @* 指标值 - 建议等待小时数 *@
                        <div class="result-value">@analysisResult.SuggestedWaitingHours 小时</div>
                    </div>
                    @* 相似用户购买频率展示 *@
                    <div class="result-item">
                        @* 指标标签 *@
                        <div class="result-label">相似购买频率</div>
                        @* 指标值 - 相似用户购买频率 *@
                        <div class="result-value">@analysisResult.SimilarUserFrequency</div>
                    </div>
                </div>

                @* 非理性因素展示区域 *@
                <div class="motivations-list">
                    @* 非理性因素标签 *@
                    <div class="result-label">非理性因素</div>
                    @* 非理性因素标签列表 *@
                    <div>
                        @* 判断是否有非理性因素数据 *@
                        @if (analysisResult.Motivations != null && analysisResult.Motivations.Any())
                        {
                            @* 遍历所有非理性因素 *@
                            @foreach (var motivation in analysisResult.Motivations)
                            {
                                @* 显示单个非理性因素标签 *@
                                <span class="motivation-tag">@motivation</span>
                            }
                        }
                        else
                        {
                            @* 无非理性因素时显示占位符 *@
                            <span>-</span>
                        }
                    </div>
                </div>

                @* 加入冷静清单按钮区域 - 当评分低于阈值时显示 *@
                @if (analysisResult.RationalityScore < Threshold)
                {
                    @* 冷静清单操作区域 *@
                    <div class="waiting-list-action">
                        @* 提示信息 - 建议冷静一下 *@
                        <p class="waiting-hint">⚠️ 需求匹配度 @analysisResult.RationalityScore% 低于阈值 @Threshold%，建议冷静一下再做决定</p>
                        @* 加入冷静清单按钮 *@
                        <button class="btn-waiting-list" @onclick="AddToWaitingList">
                            @* 按钮文本 *@
                            🧊 加入冷静清单
                        </button>
                    </div>
                }
            </div>
        }

        @* 页面底部版权信息 *@
        <div class="footer">
            @* 版权声明文本 *@
            <p>基于XXX大模型驱动 · 仅供参考</p>
        </div>
    </div>
</div>

